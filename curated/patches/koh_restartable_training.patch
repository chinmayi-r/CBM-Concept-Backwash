+def _restart_path(args):
+    if os.environ.get('KOH_RESTARTABLE', '') != '1':
+        return None
+    return os.path.join(args.log_dir, 'restart_state.pth')
+
+
+def _save_restart_state(path, model, optimizer, scheduler, epoch,
+                        best_val_epoch, best_val_acc, complete):
+    if path is None:
+        return
+    state = {
+        'format': 'koh_epoch_boundary_v1',
+        'next_epoch': epoch + 1,
+        'best_val_epoch': best_val_epoch,
+        'best_val_acc': float(best_val_acc),
+        'training_complete': bool(complete),
+        'model_state_dict': model.state_dict(),
+        'optimizer_state_dict': optimizer.state_dict(),
+        'scheduler_state_dict': scheduler.state_dict(),
+        'python_rng_state': random.getstate(),
+        'numpy_rng_state': np.random.get_state(),
+        'torch_rng_state': torch.get_rng_state(),
+        'cuda_rng_state_all': torch.cuda.get_rng_state_all(),
+    }
+    temporary = path + '.tmp'
+    torch.save(state, temporary)
+    os.replace(temporary, path)
+    backup_dir = os.environ.get('KOH_RESTART_BACKUP_DIR', '')
+    if backup_dir:
+        os.makedirs(backup_dir, exist_ok=True)
+        backup = os.path.join(backup_dir, os.path.basename(path))
+        backup_temporary = backup + '.tmp'
+        shutil.copy2(path, backup_temporary)
+        os.replace(backup_temporary, backup)
+
+
+def _optimizer_to_cuda(optimizer):
+    for state in optimizer.state.values():
+        for key, value in state.items():
+            if torch.is_tensor(value):
+                state[key] = value.cuda()
+
+
+def _apply_curated_cosine_continuation_lr(optimizer, epoch):
+    """Apply the explicitly opted-in Full-CUB continuation schedule."""
+    if os.environ.get('KOH_COSINE_CONTINUATION', '') != '1':
+        return False
+    start = int(os.environ['KOH_CONTINUATION_START_EPOCH'])
+    end = int(os.environ['KOH_CONTINUATION_END_EPOCH'])
+    start_lr = float(os.environ['KOH_CONTINUATION_START_LR'])
+    end_lr = float(os.environ['KOH_CONTINUATION_END_LR'])
+    if end <= start + 1 or not start <= epoch < end:
+        raise RuntimeError(
+            'invalid cosine continuation bounds: start=%d epoch=%d end=%d' %
+            (start, epoch, end))
+    progress = float(epoch - start) / float(end - start - 1)
+    lr = end_lr + 0.5 * (start_lr - end_lr) * (
+        1.0 + math.cos(math.pi * progress))
+    for group in optimizer.param_groups:
+        group['lr'] = lr
+    return True
+
